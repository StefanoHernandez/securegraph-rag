# SecurGraph RAG — environment template.
# Copy to `.env` and adjust for your local setup.

# ----------------------------------------------------------------------------
# Service identity
# ----------------------------------------------------------------------------
SECURGRAPH_ENV=dev
SECURGRAPH_SERVICE_NAME=securgraph-api
SECURGRAPH_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
SECURGRAPH_API_HOST=0.0.0.0
SECURGRAPH_API_PORT=8000

# Interface the compose stack publishes its ports on. Loopback by default:
# Postgres/Qdrant/Neo4j/OpenFGA/Redis/MinIO hold the data that OpenFGA and
# PostgreSQL RLS are meant to gate, so a reachable port bypasses the whole
# authorization model. Change only for a deliberately firewalled host.
SECURGRAPH_BIND_ADDR=127.0.0.1

# Addresses/CIDRs whose X-Forwarded-For may be believed — the Next.js BFF and
# any reverse proxy in front of it. Empty means the header is ignored and the
# peer address is used, so the per-IP login limiter degrades to one bucket
# instead of becoming spoofable. Set together with
# SECURGRAPH_TRUST_PROXY_HEADERS=true on the web app.
SECURGRAPH_TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# Postgres (metadata + provenance + audit)
# ----------------------------------------------------------------------------
POSTGRES_USER=securgraph
POSTGRES_PASSWORD=securgraph
POSTGRES_DB=securgraph
# Application DSN (non-superuser, RLS enforced). Migrations use the superuser DSN below.
SECURGRAPH_POSTGRES_DSN=postgresql+asyncpg://securgraph_app:securgraph_app@localhost:5432/securgraph
# Superuser DSN for `make migrate` only (creates securgraph_app via Alembic migration).
SECURGRAPH_POSTGRES_MIGRATE_DSN=postgresql+asyncpg://securgraph:securgraph@localhost:5432/securgraph

# ----------------------------------------------------------------------------
# Qdrant (vector store)
# ----------------------------------------------------------------------------
SECURGRAPH_QDRANT_URL=http://localhost:6333
SECURGRAPH_QDRANT_COLLECTION=securgraph_chunks
# Dev-only value. Chunk payloads are stored in cleartext, so an unauthenticated
# Qdrant is a full read bypass of OpenFGA. Required in stage/prod.
SECURGRAPH_QDRANT_API_KEY=dev-qdrant-key-change-me

# ----------------------------------------------------------------------------
# Neo4j (graph store)
# ----------------------------------------------------------------------------
SECURGRAPH_NEO4J_URI=bolt://localhost:7687
SECURGRAPH_NEO4J_USER=neo4j
# Dev-only value; startup refuses this exact default in stage/prod.
SECURGRAPH_NEO4J_PASSWORD=securgraph-neo4j

# ----------------------------------------------------------------------------
# OpenFGA (authorization)
# ----------------------------------------------------------------------------
SECURGRAPH_OPENFGA_API_URL=http://localhost:8080
SECURGRAPH_OPENFGA_STORE_ID=
SECURGRAPH_OPENFGA_AUTHORIZATION_MODEL_ID=
# Preshared key; must match OPENFGA_AUTHN_PRESHARED_KEYS on the server.
# OpenFGA is the ReBAC ground truth — without this anyone who reaches the API
# writes their own authorization tuples. Dev-only value. Required in stage/prod.
SECURGRAPH_OPENFGA_API_TOKEN=dev-openfga-token-change-me

# ----------------------------------------------------------------------------
# Redis (M6+: arq queue, decision cache, langgraph checkpointer in prod)
# ----------------------------------------------------------------------------
SECURGRAPH_REDIS_PASSWORD=dev-redis-password-change-me
SECURGRAPH_REDIS_URL=redis://:dev-redis-password-change-me@localhost:6379/0

# ----------------------------------------------------------------------------
# LLM providers
# Submission defaults: Mistral for generation/extraction, OpenAI for NLI.
# Ollama is a legacy local adapter and must be selected explicitly only for
# development; it is refused in stage and production.
# ----------------------------------------------------------------------------
SECURGRAPH_LLM_PROVIDER=mistral
SECURGRAPH_LLM_PROVIDER_EXTRACT=mistral
SECURGRAPH_LLM_PROVIDER_JUDGE=openai
SECURGRAPH_LLM_MODEL=mistral-small-latest
SECURGRAPH_LLM_MODEL_EXTRACT=mistral-small-latest
SECURGRAPH_LLM_MODEL_JUDGE=gpt-4o-mini
SECURGRAPH_LLM_NUM_CTX=4096

# Cloud provider API keys required by the default pipeline.
OPENAI_API_KEY=replace-me
MISTRAL_API_KEY=replace-me

# ----------------------------------------------------------------------------
# Auth & audit integrity
# ----------------------------------------------------------------------------
# Enable cookie/JWT authentication (true in any shared deployment).
# Startup REFUSES auth_enabled=false in stage/prod — dev/test only.
SECURGRAPH_AUTH_ENABLED=true
# JWT signing secret: random, >= 32 chars. Startup REFUSES the default value
# in stage/prod.
JWT_SECRET=replace-me-with-a-random-32+-char-secret
# Master key for AES-GCM encryption of stored provider credentials (>= 16 chars).
SECURGRAPH_MASTER_KEY=replace-me-with-a-random-16+-char-key
# Tamper-evident audit chaining (HMAC). Key: random 32+ byte hex string,
# stored OUTSIDE the database.
SECURGRAPH_AUDIT_TAMPER_EVIDENT=false
AUDIT_HMAC_KEY=replace-me-with-a-random-hex-key

# ----------------------------------------------------------------------------
# Embeddings (BGE-M3)
# ----------------------------------------------------------------------------
SECURGRAPH_EMBEDDING_MODEL=BAAI/bge-m3
SECURGRAPH_EMBEDDING_DEVICE=cpu
SECURGRAPH_EMBEDDING_DIM=1024

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SECURGRAPH_OTEL_ENABLED=true
SECURGRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SECURGRAPH_OTEL_TRACES_SAMPLE_RATIO=1.0
SECURGRAPH_METRICS_PORT=9464

# ----------------------------------------------------------------------------
# Limits (M7)
# ----------------------------------------------------------------------------
SECURGRAPH_MAX_GRAPH_DEPTH=2
SECURGRAPH_MAX_GRAPH_DEPTH_HARD_CAP=4
SECURGRAPH_MAX_EVIDENCE_PER_QUERY=20
SECURGRAPH_QUERY_TOKEN_BUDGET=3000

# ----------------------------------------------------------------------------
# Audit anchor storage (self-hosted MinIO Object Lock)
# Leave bucket empty to use local filesystem dev anchor storage.
# For local MinIO: `docker compose --profile anchor up` then set bucket below.
# Production requires a dedicated MinIO endpoint, bucket and credentials.
# ----------------------------------------------------------------------------
SECURGRAPH_AUDIT_ANCHOR_BUCKET=
SECURGRAPH_AUDIT_ANCHOR_PREFIX=securegraph/audit-anchors
SECURGRAPH_AUDIT_ANCHOR_ENDPOINT=
SECURGRAPH_AUDIT_ANCHOR_REGION=us-east-1
SECURGRAPH_AUDIT_ANCHOR_ACCESS_KEY=
SECURGRAPH_AUDIT_ANCHOR_SECRET_KEY=
SECURGRAPH_AUDIT_ANCHOR_RETENTION_DAYS=365
SECURGRAPH_AUDIT_ANCHOR_INTERVAL_SECONDS=3600
SECURGRAPH_AUDIT_ANCHOR_EVENT_THRESHOLD=10000

# MinIO local profile (docker/docker-compose.yml --profile anchor).
# Dev-only values: this bucket holds the audit Merkle anchors.
MINIO_ROOT_USER=securgraph-anchor-dev
MINIO_ROOT_PASSWORD=dev-minio-password-change-me
