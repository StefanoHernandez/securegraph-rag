# SecurGraph RAG — environment template.
# Copy to `.env` and adjust for your local setup.

# ----------------------------------------------------------------------------
# Service identity
# ----------------------------------------------------------------------------
SECURGRAPH_ENV=dev
SECURGRAPH_SERVICE_NAME=securgraph-api
SECURGRAPH_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
SECURGRAPH_API_HOST=0.0.0.0
SECURGRAPH_API_PORT=8000

# ----------------------------------------------------------------------------
# Postgres (metadata + provenance + audit)
# ----------------------------------------------------------------------------
POSTGRES_USER=securgraph
POSTGRES_PASSWORD=securgraph
POSTGRES_DB=securgraph
SECURGRAPH_POSTGRES_DSN=postgresql+asyncpg://securgraph:securgraph@localhost:5432/securgraph

# ----------------------------------------------------------------------------
# Qdrant (vector store)
# ----------------------------------------------------------------------------
SECURGRAPH_QDRANT_URL=http://localhost:6333
SECURGRAPH_QDRANT_COLLECTION=securgraph_chunks

# ----------------------------------------------------------------------------
# Neo4j (graph store)
# ----------------------------------------------------------------------------
SECURGRAPH_NEO4J_URI=bolt://localhost:7687
SECURGRAPH_NEO4J_USER=neo4j
SECURGRAPH_NEO4J_PASSWORD=securgraph-neo4j

# ----------------------------------------------------------------------------
# OpenFGA (authorization)
# ----------------------------------------------------------------------------
SECURGRAPH_OPENFGA_API_URL=http://localhost:8080
SECURGRAPH_OPENFGA_STORE_ID=
SECURGRAPH_OPENFGA_AUTHORIZATION_MODEL_ID=

# ----------------------------------------------------------------------------
# Redis (M6+: arq queue, decision cache, langgraph checkpointer in prod)
# ----------------------------------------------------------------------------
SECURGRAPH_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Ollama (LLM)
# Default: native macOS host (sfrutta Apple Silicon GPU).
# Container alternative: docker compose --profile ollama-container up
# ----------------------------------------------------------------------------
SECURGRAPH_OLLAMA_URL=http://localhost:11434
SECURGRAPH_LLM_MODEL=gemma3:1b
SECURGRAPH_LLM_MODEL_EXTRACT=gemma3:1b
SECURGRAPH_LLM_MODEL_JUDGE=gemma3:1b
SECURGRAPH_LLM_NUM_CTX=4096

# ----------------------------------------------------------------------------
# Embeddings (BGE-M3)
# ----------------------------------------------------------------------------
SECURGRAPH_EMBEDDING_MODEL=BAAI/bge-m3
SECURGRAPH_EMBEDDING_DEVICE=cpu
SECURGRAPH_EMBEDDING_DIM=1024

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SECURGRAPH_OTEL_ENABLED=true
SECURGRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SECURGRAPH_OTEL_TRACES_SAMPLE_RATIO=1.0
SECURGRAPH_METRICS_PORT=9464

# ----------------------------------------------------------------------------
# Limits (M7)
# ----------------------------------------------------------------------------
SECURGRAPH_MAX_GRAPH_DEPTH=2
SECURGRAPH_MAX_GRAPH_DEPTH_HARD_CAP=4
SECURGRAPH_MAX_EVIDENCE_PER_QUERY=20
SECURGRAPH_QUERY_TOKEN_BUDGET=3000
