# SecurGraph RAG — environment template.
# Copy to `.env` and adjust for your local setup.

# ----------------------------------------------------------------------------
# Service identity
# ----------------------------------------------------------------------------
SECURGRAPH_ENV=dev
SECURGRAPH_SERVICE_NAME=securgraph-api
SECURGRAPH_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
SECURGRAPH_API_HOST=0.0.0.0
SECURGRAPH_API_PORT=8000

# ----------------------------------------------------------------------------
# Postgres (metadata + provenance + audit)
# ----------------------------------------------------------------------------
POSTGRES_USER=securgraph
POSTGRES_PASSWORD=securgraph
POSTGRES_DB=securgraph
# Application DSN (non-superuser, RLS enforced). Migrations use the superuser DSN below.
SECURGRAPH_POSTGRES_DSN=postgresql+asyncpg://securgraph_app:securgraph_app@localhost:5432/securgraph
# Superuser DSN for `make migrate` only (creates securgraph_app via Alembic migration).
SECURGRAPH_POSTGRES_MIGRATE_DSN=postgresql+asyncpg://securgraph:securgraph@localhost:5432/securgraph

# ----------------------------------------------------------------------------
# Qdrant (vector store)
# ----------------------------------------------------------------------------
SECURGRAPH_QDRANT_URL=http://localhost:6333
SECURGRAPH_QDRANT_COLLECTION=securgraph_chunks

# ----------------------------------------------------------------------------
# Neo4j (graph store)
# ----------------------------------------------------------------------------
SECURGRAPH_NEO4J_URI=bolt://localhost:7687
SECURGRAPH_NEO4J_USER=neo4j
SECURGRAPH_NEO4J_PASSWORD=securgraph-neo4j

# ----------------------------------------------------------------------------
# OpenFGA (authorization)
# ----------------------------------------------------------------------------
SECURGRAPH_OPENFGA_API_URL=http://localhost:8080
SECURGRAPH_OPENFGA_STORE_ID=
SECURGRAPH_OPENFGA_AUTHORIZATION_MODEL_ID=

# ----------------------------------------------------------------------------
# Redis (M6+: arq queue, decision cache, langgraph checkpointer in prod)
# ----------------------------------------------------------------------------
SECURGRAPH_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# LLM providers
# Provider per stage: ollama (local), openai, mistral, anthropic, gemini.
# Default: native macOS Ollama host (sfrutta Apple Silicon GPU).
# Container alternative: docker compose --profile ollama-container up
# ----------------------------------------------------------------------------
SECURGRAPH_LLM_PROVIDER=ollama
SECURGRAPH_LLM_PROVIDER_EXTRACT=ollama
SECURGRAPH_LLM_PROVIDER_JUDGE=ollama
SECURGRAPH_OLLAMA_URL=http://localhost:11434
SECURGRAPH_LLM_MODEL=gemma3:1b
SECURGRAPH_LLM_MODEL_EXTRACT=gemma3:1b
SECURGRAPH_LLM_MODEL_JUDGE=gemma3:1b
SECURGRAPH_LLM_NUM_CTX=4096

# Cloud provider API keys (only needed when the matching provider is used).
OPENAI_API_KEY=replace-me
MISTRAL_API_KEY=replace-me

# ----------------------------------------------------------------------------
# Auth & audit integrity
# ----------------------------------------------------------------------------
# Enable cookie/JWT authentication (true in any shared deployment).
# Startup REFUSES auth_enabled=false in stage/prod — dev/test only.
SECURGRAPH_AUTH_ENABLED=true
# JWT signing secret: random, >= 32 chars. Startup REFUSES the default value
# in stage/prod.
JWT_SECRET=replace-me-with-a-random-32+-char-secret
# Master key for AES-GCM encryption of stored provider credentials (>= 16 chars).
SECURGRAPH_MASTER_KEY=replace-me-with-a-random-16+-char-key
# Tamper-evident audit chaining (HMAC). Key: random 32+ byte hex string,
# stored OUTSIDE the database.
SECURGRAPH_AUDIT_TAMPER_EVIDENT=false
AUDIT_HMAC_KEY=replace-me-with-a-random-hex-key

# ----------------------------------------------------------------------------
# Embeddings (BGE-M3)
# ----------------------------------------------------------------------------
SECURGRAPH_EMBEDDING_MODEL=BAAI/bge-m3
SECURGRAPH_EMBEDDING_DEVICE=cpu
SECURGRAPH_EMBEDDING_DIM=1024

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SECURGRAPH_OTEL_ENABLED=true
SECURGRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SECURGRAPH_OTEL_TRACES_SAMPLE_RATIO=1.0
SECURGRAPH_METRICS_PORT=9464

# ----------------------------------------------------------------------------
# Limits (M7)
# ----------------------------------------------------------------------------
SECURGRAPH_MAX_GRAPH_DEPTH=2
SECURGRAPH_MAX_GRAPH_DEPTH_HARD_CAP=4
SECURGRAPH_MAX_EVIDENCE_PER_QUERY=20
SECURGRAPH_QUERY_TOKEN_BUDGET=3000

# ----------------------------------------------------------------------------
# Audit anchor storage (S3 Object Lock compatible)
# Leave bucket empty to use local filesystem dev anchor storage.
# For local MinIO: `docker compose --profile anchor up` then set bucket below.
# For production AWS S3: set bucket + region, leave endpoint empty.
# ----------------------------------------------------------------------------
SECURGRAPH_AUDIT_ANCHOR_S3_BUCKET=
SECURGRAPH_AUDIT_ANCHOR_S3_PREFIX=securegraph/audit-anchors
SECURGRAPH_AUDIT_ANCHOR_S3_ENDPOINT=
SECURGRAPH_AUDIT_ANCHOR_S3_REGION=us-east-1
SECURGRAPH_AUDIT_ANCHOR_S3_ACCESS_KEY=
SECURGRAPH_AUDIT_ANCHOR_S3_SECRET_KEY=
SECURGRAPH_AUDIT_ANCHOR_RETENTION_DAYS=365
SECURGRAPH_AUDIT_ANCHOR_INTERVAL_SECONDS=3600
SECURGRAPH_AUDIT_ANCHOR_EVENT_THRESHOLD=10000

# MinIO local profile (docker/docker-compose.yml --profile anchor)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
